{
  "type": "Session",
  "id": 1,
  "name": "Mip Mapping",
  "renderer": "OpenGL",
  "shaderLanguage": "GLSL",
  "shaderCompiler": "Driver",
  "shaderCompilerSettings": {
    "autoMapBindings": "true",
    "autoMapLocations": "true",
    "autoSampledTextures": "true",
    "spirvVersion": "1.0",
    "vulkanRulesRelaxed": "true"
  },
  "shaderPreamble": "",
  "shaderIncludePaths": "",
  "audioBufferSize": 250,
  "audioChunkSize": 800,
  "audioSampleRate": 48000,
  "items": [
    {
      "type": "Texture",
      "id": 40,
      "name": "Color",
      "target": "Target2D",
      "format": "RGBA8_UNorm",
      "width": "1280",
      "height": "720",
      "samples": 1,
      "flipVertically": false
    },
    {
      "type": "Texture",
      "id": 41,
      "name": "Depth",
      "target": "Target2D",
      "format": "D32F",
      "width": "1280",
      "height": "720",
      "samples": 1,
      "flipVertically": false
    },
    {
      "type": "Target",
      "id": 42,
      "name": "Ground Target",
      "frontFace": "CCW",
      "cullMode": "NoCulling",
      "polygonMode": "Fill",
      "logicOperation": "NoLogicOperation",
      "blendConstant": "#ff000000",
      "items": [
        {
          "type": "Attachment",
          "id": 43,
          "name": "Color",
          "textureId": 40,
          "level": 0,
          "blendColorEq": "Add",
          "blendColorSource": "One",
          "blendColorDest": "Zero",
          "blendAlphaEq": "Add",
          "blendAlphaSource": "One",
          "blendAlphaDest": "Zero",
          "colorWriteMask": 15
        },
        {
          "type": "Attachment",
          "id": 44,
          "name": "Depth",
          "textureId": 41,
          "level": 0,
          "depthComparisonFunc": "Less",
          "depthOffsetSlope": 0.0,
          "depthOffsetConstant": 0.0,
          "depthClamp": false,
          "depthWrite": true
        }
      ]
    },
    {
      "type": "Texture",
      "id": 2,
      "name": "MipTexture",
      "target": "Target2D",
      "format": "RGBA8_UNorm",
      "width": "128",
      "height": "128",
      "samples": 1,
      "flipVertically": false
    },
    {
      "type": "Binding",
      "id": 10,
      "name": "uMips[0]",
      "bindingType": "Image",
      "textureId": 2,
      "level": 0,
      "layer": 0,
      "imageFormat": "Internal"
    },
    {
      "type": "Binding",
      "id": 11,
