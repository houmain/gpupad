    },
    {
      "type": "Binding",
      "id": 17,
      "name": "uMips[7]",
      "bindingType": "Image",
      "textureId": 2,
      "level": 7,
      "layer": 0,
      "imageFormat": "Internal"
    },
    {
      "type": "Program",
      "id": 30,
      "name": "Fill MipTexture",
      "items": [
        {
          "type": "Shader",
          "id": 31,
          "fileName": "mipmapping.comp",
          "shaderType": "Compute"
        }
      ]
    },
    {
      "type": "Call",
      "id": 32,
      "name": "Fill MipTexture Call",
      "checked": true,
      "callType": "Compute",
      "programId": 30,
      "workGroupsX": "8",
      "workGroupsY": "8",
      "workGroupsZ": "1",
      "executeOn": "ResetEvaluation"
    },
    {
      "type": "Binding",
      "id": 50,
      "name": "uMipTexture",
      "bindingType": "Sampler",
      "textureId": 2,
      "minFilter": "NearestMipMapNearest",
      "magFilter": "Nearest",
      "anisotropic": false,
      "wrapModeX": "Repeat",
      "wrapModeY": "Repeat",
      "wrapModeZ": "Repeat",
      "borderColor": "#ff000000",
      "comparisonFunc": "NoComparisonFunc"
    },
    {
      "type": "Program",
      "id": 60,
      "name": "Render Ground Plane",
      "items": [
        {
          "type": "Shader",
          "id": 61,
          "fileName": "ground.vert",
          "shaderType": "Vertex"
        },
        {
          "type": "Shader",
          "id": 62,
          "fileName": "ground.frag",
          "shaderType": "Fragment"
        }
      ]
    },
    {
      "type": "Call",
      "id": 70,
      "name": "Clear Color",
      "checked": true,
      "callType": "ClearTexture",
      "textureId": 40,
      "clearColor": "#ff152030",
      "clearDepth": 1.0,
      "clearStencil": 0,
      "executeOn": "EveryEvaluation"
    },
    {
      "type": "Call",
      "id": 71,
      "name": "Clear Depth",
      "checked": true,
      "callType": "ClearTexture",
      "textureId": 41,
      "clearColor": "#ff000000",
      "clearDepth": 1.0,
      "clearStencil": 0,
      "executeOn": "EveryEvaluation"
    },
    {
      "type": "Call",
      "id": 72,
      "name": "Draw Ground Plane",
      "checked": true,
      "callType": "Draw",
      "programId": 60,
      "targetId": 42,
      "vertexStreamId": 0,
      "primitiveType": "TriangleStrip",
      "count": "4",
      "first": "0",
      "instanceCount": "1",
      "baseInstance": "0",
