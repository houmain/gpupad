            "format": "R_ATI1N_UNorm",
            "width": "512",
            "height": "512",
            "samples": 1,
            "flipVertically": false
        },
        {
            "type": "Texture",
            "id": 9,
            "name": "Encoded RGTC1 blocks",
            "target": "Target2D",
            "format": "RG32U",
            "width": "128",
            "height": "128",
            "samples": 1,
            "flipVertically": false
        },
        {
            "type": "Binding",
            "id": 4,
            "name": "uSource",
            "bindingType": "Sampler",
            "textureId": 2,
            "minFilter": "Nearest",
            "magFilter": "Nearest",
            "wrapModeX": "ClampToEdge",
            "wrapModeY": "ClampToEdge",
            "wrapModeZ": "ClampToEdge",
            "anisotropic": false,
            "borderColor": "#ff000000",
            "comparisonFunc": "NoComparisonFunc"
        },
        {
            "type": "Binding",
            "id": 5,
            "name": "uDestination",
            "bindingType": "Image",
            "textureId": 9,
            "level": 0,
            "layer": 0,
            "imageFormat": "rg32ui"
        },
        {
            "type": "Program",
            "id": 6,
            "name": "RGTC1 encoder",
            "items": [
                {
                    "type": "Shader",
                    "id": 7,
                    "fileName": "rgtc1-encoder.comp",
                    "shaderType": "Compute"
                }
            ]
        },
        {
            "type": "Call",
            "id": 8,
            "name": "Encode RGTC1",
            "callType": "Compute",
            "programId": 6,
            "workGroupsX": "16",
            "workGroupsY": "16",
            "workGroupsZ": "1",
            "executeOn": "ResetEvaluation",
            "checked": true
        },
        {
            "type": "Call",
            "id": 10,
            "name": "Copy blocks to RGTC1",
