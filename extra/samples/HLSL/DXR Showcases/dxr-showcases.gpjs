{
  "type": "Session",
  "id": 1,
  "name": "DXR Showcases",
  "renderer": "Direct3D",
  "shaderLanguage": "HLSL",
  "shaderCompiler": "DXC",
  "shaderCompilerSettings": {
    "shaderModel": "6.5"
  },
  "items": [
    {
      "type": "Group",
      "id": 201,
      "name": "Settings",
      "inlineScope": true,
      "iterations": "1",
      "items": [
        {
          "type": "Binding",
          "id": 2,
          "name": "Showcase",
          "bindingType": "Uniform",
          "values": [
            "0"
          ]
        },
        {
          "type": "Binding",
          "id": 3,
          "name": "FixedTime",
          "bindingType": "Uniform",
          "values": [
            "-1"
          ]
        },
        {
          "type": "Binding",
          "id": 5,
          "name": "Indirect",
          "bindingType": "Uniform",
          "values": [
            "1"
          ]
        },
        {
          "type": "Binding",
          "id": 6,
          "name": "MaskView",
          "bindingType": "Uniform",
          "values": [
            "0"
          ]
        },
        {
          "type": "Binding",
          "id": 7,
          "name": "ActiveShowcase",
          "bindingType": "Uniform",
          "values": [
            "typeof rcShowcase === \"undefined\" ? Showcase : Number(rcShowcase)"
          ]
        },
        {
          "type": "Binding",
          "id": 8,
          "name": "PlaybackTime",
          "bindingType": "Uniform",
          "values": [
            "FixedTime < 0 ? app.time : FixedTime"
          ]
        },
        {
          "type": "Binding",
          "id": 9,
          "name": "LatticeProbe",
          "bindingType": "Uniform",
          "values": [
            "ActiveShowcase === 0 && typeof latticeFixture !== \"undefined\" && Number(latticeFixture) === 1 ? 1 : 0"
          ]
        },
        {
          "type": "Binding",
          "id": 10,
          "name": "LatticeCapture",
          "bindingType": "Uniform",
          "values": [
            "typeof latticeCapture !== \"undefined\" && Number(latticeCapture) === 1 ? 1 : 0"
          ]
        },
        {
          "type": "Binding",
          "id": 11,
          "name": "FixtureMode",
          "bindingType": "Uniform",
          "values": [
            "ActiveShowcase === 2 && typeof fieldFixture !== \"undefined\" ? Number(fieldFixture) : 0"
          ]
        },
        {
          "type": "Binding",
          "id": 12,
          "name": "ActiveIndirect",
          "bindingType": "Uniform",
          "values": [
            "typeof fieldIndirect === \"undefined\" ? Indirect : Number(fieldIndirect)"
          ]
        },
        {
          "type": "Binding",
          "id": 13,
          "name": "MaskMode",
          "bindingType": "Uniform",
          "values": [
            "typeof fieldMask === \"undefined\" ? 0 : Number(fieldMask)"
          ]
        },
        {
          "type": "Binding",
          "id": 14,
          "name": "FrameWidth",
          "bindingType": "Uniform",
          "values": [
            "LatticeProbe ? 5 : (FixtureMode ? 17 : 960)"
          ]
        },
        {
          "type": "Binding",
          "id": 15,
          "name": "FrameHeight",
          "bindingType": "Uniform",
          "values": [
            "LatticeProbe ? 1 : (FixtureMode ? 9 : 540)"
          ]
        }
      ]
    },
    {
      "type": "Texture",
      "id": 16,
      "name": "Output Image",
      "target": "Target2D",
      "format": "RGBA8_UNorm",
      "width": "960",
      "height": "540",
      "flipVertically": false
    },
